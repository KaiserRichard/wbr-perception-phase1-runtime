index 0000000000000000000000000000000000000000..237921a5b1f6098ea5523b13bdd34f8704cd1181
--- /dev/null
+++ b/experiments/2026-10-13-n4b-d435i-prep/_proposed_driver.cc
@@ -0,0 +1,197 @@
+#include <System.h>
+#include <opencv2/imgproc.hpp>
+#include "d435i_input.h"
+#include "d435i_rs.h"
+#include <csignal>
+#include <condition_variable>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <mutex>
+
+namespace { volatile std::sig_atomic_t running=1;
+void stop(int) { running=0; }
+struct Image { cv::Mat left, right; double t; };
+struct Cleanup { std::function<void()> fn; ~Cleanup() { if (fn) fn(); } };
+}
+
+int main(int argc, char** argv) {
+    if (argc<3) {
+        std::cerr << "Usage: stereo_inertial_realsense_D435i VOCAB YAML [trajectory_name] "
+                     "[--bag FILE] [--no-viewer]\n";
+        return 2;
+    }
+    std::string bag, name="wbr";
+    bool viewer=true, named=false;
+    for (int i=3; i<argc; ++i) {
+        const std::string arg(argv[i]);
+        if (arg=="--no-viewer") viewer=false;
+        else if (arg=="--bag" && i+1<argc && bag.empty()) bag=argv[++i];
+        else if (arg.rfind("--",0)!=0 && !named) { name=arg; named=true; }
+        else { std::cerr << "Invalid argument: " << arg << '\n'; return 2; }
+    }
+    if (name.empty() || name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-")!=std::string::npos) {
+        std::cerr << "trajectory name must contain only letters, digits, underscore or hyphen\n";
+        return 2;
+    }
+    for (const auto& suffix : {"_timestamps.csv", "_tracking.csv", "_CameraTrajectory.txt", "_KeyFrameTrajectory.txt"})
+        if (std::filesystem::exists(name+suffix)) {
+            std::cerr << "Refusing existing output: " << name+suffix << '\n'; return 2;
+        }
+    std::signal(SIGINT,stop);
+    std::signal(SIGTERM,stop);
+    try {
+        std::ofstream audit(name+"_timestamps.csv"), tracking(name+"_tracking.csv");
+        if (!audit || !tracking) throw std::runtime_error("cannot create output logs");
+        wbr::stamp_header(audit);
+        tracking << "image_s,state,imu_initialized,imu_samples,track_ms\n" << std::setprecision(17);
+        rs2::pipeline pipe;
+        rs2::config cfg;
+        wbr::streams(cfg);
+        if (bag.empty()) cfg.enable_device("317422076650");
+        else cfg.enable_device_from_file(bag, false); // No repeat and no physical-device query.
+        const auto resolved=cfg.resolve(pipe);
+        wbr::verify(resolved, std::cout);
+        if (bag.empty()) wbr::live_options(resolved.get_device(), std::cout);
+        auto playback=resolved.get_device().as<rs2::playback>();
+        if (!bag.empty()) {
+            if (!playback) throw std::runtime_error("file did not resolve to playback");
+            playback.set_real_time(false); // Set before callbacks start; timestamps stay recorded.
+        }
+        // Load vocabulary before acquisition: startup cannot overflow the input buffer.
+        ORB_SLAM3::System SLAM(argv[1],argv[2],ORB_SLAM3::System::IMU_STEREO,viewer,0,name);
+        std::mutex mutex;
+        std::condition_variable changed;
+        wbr::Input input;
+        std::deque<Image> images;
+        bool eof=false, played=false, closing=false;
+        std::string error;
+        int domain=-1;
+        double last_image=-INFINITY;
+        unsigned long received=0, processed=0, prefix=0, tail=0;
+        auto check_domain = [&](const rs2::frame& f) {
+            const int d=static_cast<int>(f.get_frame_timestamp_domain());
+            if (domain==-1) domain=d;
+            if (domain!=d) throw std::runtime_error("mixed/changing timestamp domains; preserve and investigate");
+        };
+        if (playback) playback.set_status_changed_callback([&](rs2_playback_status status) {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (status==RS2_PLAYBACK_STATUS_PLAYING) played=true;
+            if (status==RS2_PLAYBACK_STATUS_STOPPED && played) eof=true;
+            changed.notify_all();
+        });
+        auto callback = [&](const rs2::frame& f) {
+            std::unique_lock<std::mutex> lock(mutex);
+            if (closing || !error.empty()) return;
+            try {
+                if (auto fs=f.as<rs2::frameset>()) {
+                    const auto l=fs.get_infrared_frame(1), r=fs.get_infrared_frame(2);
+                    if (!l || !r) throw std::runtime_error("incomplete stereo frameset");
+                    wbr::stamp(audit,l); wbr::stamp(audit,r);
+                    check_domain(l); check_domain(r);
+                    const double t=l.get_timestamp()*1e-3;
+                    if (!std::isfinite(t) || t<=last_image || std::abs(l.get_timestamp()-r.get_timestamp())>1.0)
+                        throw std::runtime_error("invalid/repeated stereo stamps or >1 ms pair skew");
+                    last_image=t; ++received;
+                    if (images.size()>=8) {
+                        // Non-real-time playback waits for processing. Live overload fails explicitly.
+                        if (!playback || !changed.wait_for(lock,std::chrono::seconds(10),[&]{
+                            return images.size()<8 || closing || !error.empty() || !running;
+                        })) throw std::runtime_error("image queue overflow/backpressure timeout");
+                    }
+                    if (closing || !error.empty() || !running) return;
+                    // Own pixels and honor row stride; no dangling SDK data pointers.
+                    images.push_back({cv::Mat(l.get_height(),l.get_width(),CV_8U,
+                        const_cast<void*>(l.get_data()),l.get_stride_in_bytes()).clone(),
+                        cv::Mat(r.get_height(),r.get_width(),CV_8U,
+                        const_cast<void*>(r.get_data()),r.get_stride_in_bytes()).clone(),t});
+                } else if (auto m=f.as<rs2::motion_frame>()) {
+                    wbr::stamp(audit,m); check_domain(m);
+                    const auto v=m.get_motion_data();
+                    const wbr::Sample sample{m.get_timestamp()*1e-3,{v.x,v.y,v.z}};
+                    if (m.get_profile().stream_type()==RS2_STREAM_GYRO) input.gyro(sample);
+                    else if (m.get_profile().stream_type()==RS2_STREAM_ACCEL) input.accel(sample);
+                }
+                changed.notify_all();
+            } catch (const std::exception& e) { error=e.what(); changed.notify_all(); }
+        };
+        bool started=false;
+        Cleanup cleanup{[&] {
+            { std::lock_guard<std::mutex> lock(mutex); closing=true; changed.notify_all(); }
+            if (started) {
+                try { pipe.stop(); }
+                catch (const std::exception& e) { std::cerr << "pipeline stop error: " << e.what() << '\n'; }
+            }
+            SLAM.Shutdown();
+        }};
+        pipe.start(cfg,callback);
+        started=true;
+        bool first=true, initialized=false;
+        auto progress=std::chrono::steady_clock::now();
+        while (running && !SLAM.isShutDown()) {
+            Image image;
+            std::vector<wbr::Combined> samples;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                changed.wait_for(lock,std::chrono::milliseconds(100));
+                if (!error.empty()) break;
+                if (first) input.trim_prefix();
+                if (images.empty()) {
+                    if (eof) break;
+                } else if (first && input.before_coverage(images.front().t)) {
+                    images.pop_front(); ++prefix; changed.notify_all(); continue;
+                } else if (input.ready(images.front().t)) {
+                    image=images.front(); images.pop_front();
+                    samples=input.take(image.t); changed.notify_all();
+                } else if (eof) {
+                    tail=images.size(); images.clear(); break;
+                }
+                if (samples.empty()) {
+                    if (std::chrono::steady_clock::now()-progress>std::chrono::seconds(5)) {
+                        error="no processable stereo/IMU coverage for 5 s"; break;
+                    }
+                    continue;
+                }
+            }
+            first=false;
+            std::vector<ORB_SLAM3::IMU::Point> imu;
+            for (const auto& s : samples)
+                imu.emplace_back(s.accel.x,s.accel.y,s.accel.z,s.gyro.x,s.gyro.y,s.gyro.z,s.t);
+            const float scale=SLAM.GetImageScale();
+            if (scale!=1.f) {
+                cv::resize(image.left,image.left,cv::Size(),scale,scale);
+                cv::resize(image.right,image.right,cv::Size(),scale,scale);
+            }
+            const auto start=std::chrono::steady_clock::now();
+            SLAM.TrackStereo(image.left,image.right,image.t,imu);
+            const auto end=std::chrono::steady_clock::now();
+            const bool now_initialized=SLAM.GetTimeFromIMUInit()>0;
+            if (now_initialized && !initialized) std::cout << "IMU initialized (System.GetTimeFromIMUInit > 0)\n";
+            initialized=now_initialized;
+            tracking << image.t << ',' << SLAM.GetTrackingState() << ',' << initialized << ','
+                     << imu.size() << ',' << std::chrono::duration<double,std::milli>(end-start).count() << '\n';
+            if (!tracking) { std::lock_guard<std::mutex> lock(mutex); error="tracking audit write failed"; break; }
+            ++processed; progress=end;
+        }
+        cleanup.fn(); // Wake blocked callbacks before stop; EOF is drained above.
+        cleanup.fn={};
+        audit.flush(); tracking.flush();
+        std::cout << "received=" << received << " processed=" << processed
+                  << " prefix_images=" << prefix << " prefix_gyro=" << input.prefix_gyro
+                  << " uncovered_tail_images=" << tail << " pending_images=" << images.size() << '\n';
+        if (!error.empty() || !audit || !tracking || !processed) {
+            std::cerr << "OPEN: input/run error: " << error << '\n'; return 1;
+        }
+        // The pinned exporter dereferences the largest map; avoid empty-map calls.
+        if (SLAM.GetTrackedMapPoints().empty()) {
+            std::cerr << "OPEN: no tracked map points at shutdown; inspect logs\n"; return 1;
+        }
+        SLAM.SaveTrajectoryEuRoC(name+"_CameraTrajectory.txt"); // Also prints atlas map count.
+        SLAM.SaveKeyFrameTrajectoryEuRoC(name+"_KeyFrameTrajectory.txt");
+        std::cout << "OPEN: run completed; inspect initialization, tracking and provenance\n";
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << "OPEN: driver error: " << e.what() << '\n'; return 1;
+    }
+}
diff --git a/experiments/2026-10-13-n4b-d435i-prep/calibration_notes.md b/experiments/2026-10-13-n4b-d435i-prep/calibration_notes.md
new file mode 100644
index 0000000000000000000000000000000000000000..20bf41fd171248ebbb54a13b8462f48e77ea4294
--- /dev/null
+++ b/experiments/2026-10-13-n4b-d435i-prep/calibration_notes.md
@@ -0,0 +1,149 @@
+# Configuration review — OPEN
+
+This is a runnable development candidate for SDK serial **317422076650**, firmware
+**5.17.3.10**, IMU **BMI085**. It does not qualify N4. All hardware, timing,
+calibration, offline VIO and live VIO conclusions remain **OPEN**.
+
+## Sources and classifications
+
+- **M — MEASURED readback:** [2026-10-13 factory enumeration](../2026-10-13-pi5-env-snapshot/rs_calibration_new_unit.txt),
+  produced by `rs-enumerate-devices -c`. This classification describes observed
+  SDK values, not a new independent optical or inertial calibration experiment.
+- **U — SOURCE-SUPPORTED:** pinned [RealSense_D435i.yaml](../../third_party/ORB_SLAM3/Examples/Stereo-Inertial/RealSense_D435i.yaml),
+  commit `4452a3c4ab75b1cde34e5505a36ec3f9edcdc4c4`.
+- **S — SOURCE-SUPPORTED:** the same commit's [Settings.cc](../../third_party/ORB_SLAM3/src/Settings.cc),
+  [ImuTypes.cc](../../third_party/ORB_SLAM3/src/ImuTypes.cc),
+  [Frame.cc](../../third_party/ORB_SLAM3/src/Frame.cc) and
+  [EuRoC.yaml](../../third_party/ORB_SLAM3/Examples/Stereo-Inertial/EuRoC.yaml).
+- **A — ASSUMED:** an operating/tuning choice for this unit, subject to measurement.
+
+The SDK serial is distinct from ASIC serial `327743061057`, firmware-update ID
+`327743061057`, and separately observed USB descriptor serial `327743061057`.
+The [swap addendum](../2026-10-13-pi5-env-snapshot/ADDENDUM_CAMERA_SWAP.md)
+establishes that old SDK serial `243322073847` is a different unit. Its tests and
+calibration results do not transfer.
+
+## Rectified stereo schema
+
+The new enumeration's IR1 and IR2 640×480 Y8 blocks (lines 326–334 and 414–422)
+both give `fx=fy=386.953308105469`, `cx=321.034301757812`,
+`cy=241.040130615234`, Brown Conrady coefficients `[0,0,0,0,0]`.
+These are the SDK rectified stream projections; physical lens distortion has
+not been independently measured. No second software rectification is proposed.
+
+`File.version: "1.0"`, `Camera.type: "Rectified"`, `Camera1.*` and `Stereo.b`
+follow the actual Settings parser. For Rectified, it does not read `Camera2.*`
+or distortion coefficients; identical right projection is assumed. Thus IR2
+values are documented here and in the YAML comment rather than added as unused
+keys. Do not substitute the EuRoC PinHole schema or legacy `Camera.bf`/`Tbc`.
+
+The measured SDK transform IR1→IR2 is `R=I`, `t=[-0.049912553280592,0,0] m`.
+The right camera center in left coordinates is `-R^T t=[+b,0,0]`.
+ORB wants the positive magnitude `Stereo.b=0.049912553280592 m` and computes
+`bf=fx*b≈19.31382761 pixel·m`. There is no sign reversal of disparity.
+
+## Transform direction and math
+
+Let `c1` denote the SDK left IR optical frame and `b` the SDK gyro/body frame.
+RealSense extrinsics **from A to B** act on points as
+`p_B=R_BA p_A+t_BA` in metres. The API rotation array is column-major; OpenCV
+matrix `data` is row-major. Identity rotation makes that distinction numerically
+invisible here. Keep the raw SDK IMU axes; do not additionally rotate to a ROS
+camera_link, ENU, NED or controller body convention.
+
+The new file's IR1→Gyro and IR1→Accel both give:
+
+```text
+R_bc = I
+t_bc = [-0.00552000012248755, +0.00510000018402934, +0.011739999987185] m
+T_bc = [ I  t_bc ]
+       [ 0   1  ]
+p_b = T_bc p_c1
+```
+
+Gyro↔Accel is identity with zero translation in the readback; shared physical
+alignment is still unmeasured. The reverse Gyro/Accel→IR1 readback is:
+
+```text
+T_cb = inverse(T_bc) = [ R_bc^T  -R_bc^T t_bc ]
+                      [   0          1      ]
+t_cb = [+0.00552000012248755, -0.00510000018402934, -0.011739999987185] m
+T_cb T_bc = I
+```
+
+**ORB's actual `IMU.T_b_c1` is `T_bc`: camera→body**, despite the upstream
+RealSense comment saying “Transformation from body-frame (imu) to left camera”.
+The EuRoC comment says camera→body. The executable evidence is stronger:
+`ImuTypes.cc` sets `mTcb=mTbc.inverse()` and `Frame.cc` sets
+`T_cw=T_cb*T_bw`. Therefore the YAML must use the IR1→Gyro transform directly.
+Using the reverse readback under this key would invert all three translation
+signs incorrectly. A camera-origin test gives `p_b=t_bc`; body origin maps to
+`p_c1=-t_bc`. The positive Y value corrects the upstream example's negative Y.
+
+The numbers are **MEASURED SDK readback**, while their interpretation as nominal
+mechanical/CAD geometry is **INFERRED / SOURCE-SUPPORTED**, not per-unit IMU
+alignment calibration. [Repository calibration readiness](../../docs/D435I_VIO_CALIBRATION_READINESS.md)
+documents the SDK fallback and links the official
+[librealsense parser v2.58.4](https://github.com/realsenseai/librealsense/blob/v2.58.4/src/ds/ds-calib-parsers.cpp).
+Its earlier raw fallback logs concern the old unit; the new numeric values match
+that nominal geometry. No Intel document with a mechanical-calibration quotation
+was found in the requested repository docs, and no online source was fetched.
+The SDK source URL is an existing repository citation, not a newly verified
+claim about the currently installed binary.
+
+The SDK warning reported in the ticket is **“IMU Calibration is not available”**;
+the full warning preserved for the old unit is “IMU Calibration is not available,
+default intrinsic and extrinsic will be used.” The new calibration text itself
+does not include a warning line. Preserve new raw SDK stderr during later tests
+and do not silently attribute old warning logs to this serial.
+
+New gyro/accel readback gives identity sensitivity, zero bias, zero noise
+variance and zero bias variance (lines 471–488). These are not evidence of a
+noiseless IMU. Whether `rs-imu-calibration` was ever run successfully for this
+unit is **UNKNOWN**; treat IMU intrinsics as uncalibrated until evidence resolves
+the warning/defaults. No calibration tool or firmware operation is authorized
+by this preparation. Spatial/temporal calibration and a stationary full-precision
+Allan-variance run are required before N4 qualification. Choose duration from
+the desired averaging times, normally hours rather than this 60–90 s VIO take;
+use qualified storage and a separately reviewed procedure.
+
+## Upstream versus candidate
+
+All upstream entries below are **U**. Candidate values marked **U+A** reuse
+example values as assumptions for this unit. Noise units are continuous-time
+density units, not SDK variance-array entries.
+
+| Key / quantity | Upstream RealSense_D435i.yaml | Candidate | Candidate source |
+|---|---|---|---|
+| File.version / Camera.type | `"1.0"` / `Rectified` | same | S: exact parser schema |
+| Camera1.fx / fy (px) | 382.613 / 382.613 | 386.953308105469 / same | M: IR1 640×480 |
+| Camera1.cx / cy (px) | 320.183 / 236.455 | 321.034301757812 / 241.040130615234 | M: IR1 |
+| IR2 fx/fy/cx/cy | implicit same rectified projection | same as IR1 | M: IR2; S: no Camera2 keys read |
+| Distortion | implicit ideal rectified pinhole | five zeros, omitted from schema | M: both IR blocks; S |
+| Stereo.b (m) | 0.0499585 | 0.049912553280592 | M: magnitude of IR1→IR2 t_x |
+| Camera.width / height | 640 / 480 | same | M capability; A selection |
+| Camera.fps | 30 | 30 | M capability; A choice to match example and motion |
+| Camera.RGB | 1 | 1 | U+A; ignored for Y8 |
+| Stereo.ThDepth | 40.0 | 40.0 | U+A; close threshold ≈1.9965 m |
+| IMU.T_b_c1 rotation | identity | identity | M readback; nominal physical interpretation |
+| IMU.T_b_c1 t_x (m) | -0.005 | -0.00552000012248755 | M IR1→Gyro |
+| IMU.T_b_c1 t_y (m) | -0.005 | +0.00510000018402934 | M; direction established by S |
+| IMU.T_b_c1 t_z (m) | +0.0117 | +0.011739999987185 | M IR1→Gyro |
+| IMU.InsertKFsWhenLost | 0 | 0 | U+A |
+| IMU.NoiseGyro (rad/s/√Hz) | 1e-3 | 1e-3 | U+A; Allan variance required |
+| IMU.NoiseAcc (m/s²/√Hz) | 1e-2 | 1e-2 | U+A; Allan variance required |
+| IMU.GyroWalk (rad/s²/√Hz) | 1e-6 | 1e-6 | U+A; Allan variance required |
+| IMU.AccWalk (m/s³/√Hz) | 1e-4 | 1e-4 | U+A; Allan variance required |
+| IMU.Frequency | 200.0 | 200.0 | U+A: gyro-grid input, not accel rate |
+| ORBextractor.nFeatures | 1250 | 1250 | U+A |
+| ORBextractor.scaleFactor / nLevels | 1.2 / 8 | same | U+A |
+| ORBextractor.iniThFAST / minThFAST | 20 / 7 | same | U+A |
+| Viewer.KeyFrameSize / KeyFrameLineWidth | 0.05 / 1.0 | same | U+A |
+| Viewer.GraphLineWidth / PointSize | 0.9 / 2.0 | same | U+A |
+| Viewer.CameraSize / CameraLineWidth | 0.08 / 3.0 | same | U+A |
+| Viewer.ViewpointX/Y/Z/F | 0.0 / -0.7 / -3.5 / 500.0 | same | U+A; `--no-viewer` for Pi |
+
+Noise densities are left continuous-time: the pinned tracking setup applies
+`sqrt(IMU.Frequency)` scaling to measurement noise and inverse scaling to walks.
+Do not apply that conversion twice. Bias, scale, actual sample rates and
+camera–IMU time offset remain **UNKNOWN**, rather than assumed calibrated to zero.
diff --git a/experiments/2026-10-13-n4b-d435i-prep/d435i_input.h b/experiments/2026-10-13-n4b-d435i-prep/d435i_input.h
new file mode 100644
index 0000000000000000000000000000000000000000..88fe9cff87feadc3e4b9c703c6f40293b03d8360
--- /dev/null
+++ b/experiments/2026-10-13-n4b-d435i-prep/d435i_input.h
@@ -0,0 +1,64 @@
+// Status: OPEN. Pure input association for synthetic checks and the proposed driver.
+#pragma once
+#include <cmath>
+#include <deque>
+#include <stdexcept>
+#include <vector>
+
+namespace wbr {
+struct Vec3 { double x, y, z; };
+struct Sample { double t; Vec3 v; };
+struct Combined { double t; Vec3 accel, gyro; };
+inline Vec3 interpolate(const Sample& a, const Sample& b, double t) {
+    if (!(a.t < b.t && a.t <= t && t <= b.t))
+        throw std::runtime_error("accel requires strictly ordered brackets; no extrapolation");
+    const double u = (t-a.t)/(b.t-a.t);
+    return {a.v.x+u*(b.v.x-a.v.x), a.v.y+u*(b.v.y-a.v.y),
+            a.v.z+u*(b.v.z-a.v.z)};
+}
+class Input {
+    std::deque<Sample> accel_, gyro_;
+    double last_accel_ = -INFINITY, last_gyro_ = -INFINITY;
+    static void append(std::deque<Sample>& q, double& last, Sample s) {
+        if (!std::isfinite(s.t) || !std::isfinite(s.v.x) || !std::isfinite(s.v.y) ||
+            !std::isfinite(s.v.z) || s.t <= last)
+            throw std::runtime_error("nonfinite or duplicate/backward IMU sample");
+        // Development guard only; does not replace the N2 timing thresholds.
+        if (std::isfinite(last) && s.t-last > 0.05)
+            throw std::runtime_error("IMU gap exceeds development guard of 50 ms");
+        if (q.size() >= 4096) throw std::runtime_error("IMU queue overflow");
+        last = s.t;
+        q.push_back(s);
+    }
+public:
+    unsigned long prefix_gyro = 0;
+    void accel(Sample s) { append(accel_, last_accel_, s); }
+    void gyro(Sample s) { append(gyro_, last_gyro_, s); }
+    void trim_prefix() {
+        while (!accel_.empty() && !gyro_.empty() && gyro_.front().t < accel_.front().t) {
+            gyro_.pop_front(); ++prefix_gyro;
+        }
+    }
+    bool before_coverage(double t) const {
+        return !gyro_.empty() && t < gyro_.front().t;
+    }
+    bool ready(double t) const {
+        if (accel_.size() < 2 || gyro_.empty()) return false;
+        for (const auto& g : gyro_) if (g.t >= t)
+            return accel_.front().t <= gyro_.front().t && accel_.back().t >= g.t;
+        return false;
+    }
+    std::vector<Combined> take(double t) {
+        if (!ready(t)) throw std::runtime_error("missing trailing gyro/accel coverage");
+        std::vector<Combined> result;
+        do {
+            const auto g = gyro_.front(); gyro_.pop_front();
+            while (accel_.size() > 2 && accel_[1].t <= g.t) accel_.pop_front();
+            result.push_back({g.t, interpolate(accel_[0], accel_[1], g.t), g.v});
+        } while (result.back().t < t);
+        // Include the first gyro >= image stamp once. ORB retains that endpoint
+        // internally for the next preintegration interval (Tracking.cc).
+        return result;
+    }
+};
+} // namespace wbr
diff --git a/experiments/2026-10-13-n4b-d435i-prep/d435i_record.cpp b/experiments/2026-10-13-n4b-d435i-prep/d435i_record.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7970303de11c20ae497bb1c79c282e4ced49085e
--- /dev/null
+++ b/experiments/2026-10-13-n4b-d435i-prep/d435i_record.cpp
@@ -0,0 +1,81 @@
+// Status: OPEN. Future Pi-only recorder; no camera execution or SDK build on Mac.
+#include "d435i_rs.h"
+#include <csignal>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <mutex>
+#include <thread>
+
+namespace { volatile std::sig_atomic_t running = 1;
+void stop(int) { running = 0; } }
+
+int main(int argc, char** argv) {
+    if (argc != 3) {
+        std::cerr << "Usage: d435i_record NEW_OUTPUT_DIRECTORY SECONDS (1..120)\n";
+        return 2;
+    }
+    try {
+        std::size_t used=0;
+        const double seconds=std::stod(argv[2], &used);
+        if (used!=std::string(argv[2]).size() || !std::isfinite(seconds) || seconds<1 || seconds>120)
+            throw std::runtime_error("duration must be 1..120 seconds");
+        const std::filesystem::path dir(argv[1]);
+        if (!std::filesystem::create_directory(dir))
+            throw std::runtime_error("output directory must be new; parent must already exist");
+        std::ofstream audit(dir/"timestamps.csv");
+        if (!audit) throw std::runtime_error("cannot create timestamp audit");
+        wbr::stamp_header(audit);
+        rs2::log_to_file(RS2_LOG_SEVERITY_INFO, (dir/"sdk.log").string().c_str());
+        std::signal(SIGINT, stop);
+        std::signal(SIGTERM, stop);
+        rs2::pipeline pipe;
+        rs2::config cfg;
+        wbr::streams(cfg);
+        cfg.enable_device("317422076650");
+        cfg.enable_record_to_file((dir/"stereo_imu.bag").string());
+        auto resolved=cfg.resolve(pipe);
+        wbr::verify(resolved, std::cout);
+        wbr::live_options(resolved.get_device(), std::cout);
+        std::mutex mutex;
+        std::string error;
+        unsigned long left=0, right=0, gyro=0, accel=0;
+        auto callback = [&](const rs2::frame& frame) {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (!error.empty()) return;
+            try {
+                if (auto fs=frame.as<rs2::frameset>()) {
+                    for (const auto& f : fs) {
+                        wbr::stamp(audit, f);
+                        if (f.get_profile().stream_type()==RS2_STREAM_INFRARED) {
+                            if (f.get_profile().stream_index()==1) ++left;
+                            if (f.get_profile().stream_index()==2) ++right;
+                        }
+                    }
+                } else {
+                    wbr::stamp(audit, frame);
+                    if (frame.get_profile().stream_type()==RS2_STREAM_GYRO) ++gyro;
+                    if (frame.get_profile().stream_type()==RS2_STREAM_ACCEL) ++accel;
+                }
+            } catch (const std::exception& e) { error=e.what(); }
+        };
+        pipe.start(cfg, callback);
+        const auto begin=std::chrono::steady_clock::now();
+        while (running && std::chrono::duration<double>(std::chrono::steady_clock::now()-begin).count()<seconds) {
+            { std::lock_guard<std::mutex> lock(mutex); if (!error.empty()) break; }
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+        pipe.stop(); // Normal shutdown finalizes the librealsense bag; no forced kill.
+        audit.flush();
+        std::cout << "callback counts IR1=" << left << " IR2=" << right
+                  << " gyro=" << gyro << " accel=" << accel << '\n';
+        if (!error.empty()) throw std::runtime_error(error);
+        if (!audit || !left || !right || !gyro || !accel)
+            throw std::runtime_error("missing stream or audit flush failure");
+        std::cout << "OPEN: recorded; decode/count/timing/storage qualification still required\n";
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << "OPEN: recorder error: " << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/experiments/2026-10-13-n4b-d435i-prep/d435i_rs.h b/experiments/2026-10-13-n4b-d435i-prep/d435i_rs.h
new file mode 100644
index 0000000000000000000000000000000000000000..12e1c5f3049814ce3285d604df26858a01f8382a
--- /dev/null
+++ b/experiments/2026-10-13-n4b-d435i-prep/d435i_rs.h
@@ -0,0 +1,94 @@
+// Status: OPEN. Shared fixed stream selection and audit logging; SDK compile unverified.
+#pragma once
+#include <librealsense2/rs.hpp>
+#include <chrono>
+#include <cmath>
+#include <iomanip>
+#include <ostream>
+#include <stdexcept>
+#include <string>
+
+namespace wbr {
+inline void streams(rs2::config& cfg) {
+    cfg.disable_all_streams();
+    cfg.enable_stream(RS2_STREAM_INFRARED, 1, 640, 480, RS2_FORMAT_Y8, 30);
+    cfg.enable_stream(RS2_STREAM_INFRARED, 2, 640, 480, RS2_FORMAT_Y8, 30);
+    cfg.enable_stream(RS2_STREAM_GYRO, RS2_FORMAT_MOTION_XYZ32F, 200);
+    cfg.enable_stream(RS2_STREAM_ACCEL, RS2_FORMAT_MOTION_XYZ32F, 100);
+}
+inline void live_options(rs2::device dev, std::ostream& log) {
+    bool emitter = false;
+    for (auto sensor : dev.query_sensors()) {
+        if (sensor.supports(RS2_OPTION_EMITTER_ENABLED)) {
+            sensor.set_option(RS2_OPTION_EMITTER_ENABLED, 0);
+            if (sensor.get_option(RS2_OPTION_EMITTER_ENABLED) != 0)
+                throw std::runtime_error("emitter OFF readback failed");
+            emitter = true;
+        }
+        // Preserve current global-time and motion-correction options; log them.
+        // No persistent device/calibration changes or implicit global-time toggle.
+        for (auto option : {RS2_OPTION_GLOBAL_TIME_ENABLED, RS2_OPTION_ENABLE_MOTION_CORRECTION})
+            if (sensor.supports(option))
+                log << sensor.get_info(RS2_CAMERA_INFO_NAME) << " " << option << "="
+                    << sensor.get_option(option) << '\n';
+    }
+    if (!emitter) throw std::runtime_error("no emitter control; cannot attest OFF");
+    log << "emitter=0 (read back before streaming)\n";
+}
+inline void verify(rs2::pipeline_profile profile, std::ostream& log) {
+    const auto dev = profile.get_device();
+    if (std::string(dev.get_info(RS2_CAMERA_INFO_SERIAL_NUMBER)) != "317422076650")
+        throw std::runtime_error("wrong SDK device serial");
+    log << "SDK serial=" << dev.get_info(RS2_CAMERA_INFO_SERIAL_NUMBER)
+        << " firmware=" << dev.get_info(RS2_CAMERA_INFO_FIRMWARE_VERSION) << '\n';
+    const auto profiles = profile.get_streams();
+    if (profiles.size() != 4) throw std::runtime_error("expected exactly four streams");
+    bool left=false, right=false, gyro=false, accel=false;
+    for (auto p : profiles) {
+        log << p.stream_name() << " index=" << p.stream_index() << " format="
+            << p.format() << " fps=" << p.fps() << '\n';
+        if (p.stream_type() == RS2_STREAM_INFRARED) {
+            const auto v = p.as<rs2::video_stream_profile>();
+            if (v.width()!=640 || v.height()!=480 || p.fps()!=30 || p.format()!=RS2_FORMAT_Y8)
+                throw std::runtime_error("wrong IR profile");
+            const auto k=v.get_intrinsics();
+            log << std::setprecision(17) << "IR" << p.stream_index() << " intrinsics="
+                << k.fx << ',' << k.fy << ',' << k.ppx << ',' << k.ppy << " distortion=" << k.model;
+            for (float c : k.coeffs) log << ',' << c;
+            log << '\n';
+            if (std::abs(k.fx-386.953308105469)>1e-4 || std::abs(k.fy-386.953308105469)>1e-4 ||
+                std::abs(k.ppx-321.034301757812)>1e-4 || std::abs(k.ppy-241.040130615234)>1e-4)
+                throw std::runtime_error("IR projection differs from candidate calibration");
+            for (float c : k.coeffs) if (std::abs(c)>1e-8)
+                throw std::runtime_error("IR distortion differs from rectified candidate");
+            if (p.stream_index()==1) left=true;
+            else if (p.stream_index()==2) right=true;
+        } else if (p.stream_type()==RS2_STREAM_GYRO)
+            gyro = p.fps()==200 && p.format()==RS2_FORMAT_MOTION_XYZ32F;
+        else if (p.stream_type()==RS2_STREAM_ACCEL)
+            accel = p.fps()==100 && p.format()==RS2_FORMAT_MOTION_XYZ32F;
+    }
+    if (!(left && right && gyro && accel)) throw std::runtime_error("wrong stream set");
+}
+inline void stamp_header(std::ostream& out) {
+    out << "stream,index,frame_number,sdk_ms,domain,host_steady_ns,host_utc_ns,x,y,z,exposure_us\n";
+    out << std::setprecision(17);
+}
+inline void stamp(std::ostream& out, const rs2::frame& f) {
+    const auto mono = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    const auto utc = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    out << f.get_profile().stream_name() << ',' << f.get_profile().stream_index()
+        << ',' << f.get_frame_number() << ',' << f.get_timestamp() << ','
+        << rs2_timestamp_domain_to_string(f.get_frame_timestamp_domain()) << ',' << mono << ',' << utc;
+    if (auto m = f.as<rs2::motion_frame>()) {
+        const auto v=m.get_motion_data(); out << ',' << v.x << ',' << v.y << ',' << v.z;
+    } else out << ",,,";
+    out << ',';
+    if (f.supports_frame_metadata(RS2_FRAME_METADATA_ACTUAL_EXPOSURE))
+        out << f.get_frame_metadata(RS2_FRAME_METADATA_ACTUAL_EXPOSURE);
+    out << '\n';
+    if (!out) throw std::runtime_error("timestamp audit write failed");
+}
+} // namespace wbr
diff --git a/experiments/2026-10-13-n4b-d435i-prep/n4b_plan.md b/experiments/2026-10-13-n4b-d435i-prep/n4b_plan.md
new file mode 100644
