#!/usr/bin/env python3
"""One-Hz Pi health sampler; no camera API and no background worker threads."""
from datetime import datetime, timezone
import os
from pathlib import Path
import re
import shutil
import subprocess
import time


def command(argv):
    result = subprocess.run(argv, text=True, capture_output=True, timeout=5)
    if result.returncode:
        raise RuntimeError(f"{argv[0]} failed ({result.returncode}): {result.stderr.strip()}")
    return result.stdout.strip()


class HealthSampler:
    """The capture owner calls sample once per second and owns serialization."""

    def __init__(self, output):
        self.output = Path(output)
        self.previous_cpu = None
        self.previous_process = None
        self.tick_hz = os.sysconf("SC_CLK_TCK")
        self.page_bytes = os.sysconf("SC_PAGE_SIZE")

    def sample(self, pid=None):
        now = time.monotonic()
        values = [int(v) for v in Path("/proc/stat").read_text().splitlines()[0].split()[1:9]]
        cpu = (sum(values), values[3] + values[4])
        busy = None
        if self.previous_cpu and cpu[0] > self.previous_cpu[0]:
            busy = 100 * (1 - (cpu[1] - self.previous_cpu[1]) / (cpu[0] - self.previous_cpu[0]))
        self.previous_cpu = cpu
        memory = dict(line.split(":", 1) for line in Path("/proc/meminfo").read_text().splitlines())
        throttle_text = command(["vcgencmd", "get_throttled"])
        match = re.fullmatch(r"throttled=(0x[0-9a-fA-F]+)", throttle_text)
        if not match:
            raise RuntimeError(f"Cannot interpret throttling flags: {throttle_text}")
        measure_temp = command(["vcgencmd", "measure_temp"])
        temp_match = re.fullmatch(r"temp=([0-9.]+)'C", measure_temp)
        if not temp_match:
            raise RuntimeError(f"Cannot interpret measure_temp: {measure_temp}")
        result = {"utc": datetime.now(timezone.utc).isoformat(), "monotonic_seconds": now,
                  "temperature_c": float(Path("/sys/class/thermal/thermal_zone0/temp").read_text()) / 1000,
                  "vcgencmd_temperature_c": float(temp_match[1]),
                  "throttled": match[1], "throttled_value": int(match[1], 16),
                  "memory_available_kib": int(memory["MemAvailable"].split()[0]),
                  "system_cpu_busy_percent": busy, "process_pid": pid,
                  "process_cpu_percent": None, "process_rss_bytes": None,
                  "storage_free_bytes": shutil.disk_usage(self.output).free}
        if pid is not None:
            try:
                # comm can contain spaces and ')'; the last ')' ends the comm field.
                fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
                ticks = int(fields[11]) + int(fields[12])
                result["process_rss_bytes"] = int(fields[21]) * self.page_bytes
                if self.previous_process and self.previous_process[0] == pid:
                    result["process_cpu_percent"] = 100 * (ticks - self.previous_process[1]) / self.tick_hz / (now - self.previous_process[2])
                self.previous_process = (pid, ticks, now)
            except FileNotFoundError:
                result["process_exited_before_sample"] = True
        return result


def failures(sample):
    errors = []
    if sample["throttled_value"] != 0:
        errors.append("Nonzero current or historical Pi power/thermal flags")
    if sample["temperature_c"] >= 80 or sample["vcgencmd_temperature_c"] >= 80:
        errors.append("Pi temperature is at or above conservative 80 C stop threshold")
    if sample["memory_available_kib"] < 256 * 1024:
        errors.append("MemAvailable below 256 MiB guard")
    if sample["storage_free_bytes"] < 256 * 1024**2:
        errors.append("Less than 256 MiB free for metadata/log finalization")
    return errors
#!/usr/bin/env python3
"""Create/verify a small Mac-canonical runtime bundle; no SSH or camera access."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess

from validation_common import sha256, utc, write_json

HERE = Path(__file__).resolve().parent
# Historical runners/results are deliberately excluded from future runtime execution.
FILES = '''validation_common.py n1_precheck.py wbr-d435i-iio-permissions.py
99-wbr-d435i.rules sdk_capture.py sdk_analysis.py sample_ir_checked.cpp camera_metadata.cpp
image_content.py health_monitor.py kernel_analysis.py storage_qualify.py
n3_metrics.py n3_observer.py n3_bag.py n3_record.py bounded_microsd.py phase_gate.py
n3_baseline.yaml n3_topics.json n3_qos.yaml platform_inspect.py
bundle_runtime.py wrapper_inspect.py test_gate_tooling.py test_n2_tooling.py test_bounded_microsd.py
test_n3_metrics.py test_takeover_tooling.py test_ros_offline.py
sdk-enumeration-full.txt sustained-sdk.log sustained-analysis.json
PHASE_A_RUNBOOK.md N3_PREPARATION.md'''.split()


def build(output):
    missing = [name for name in FILES if not (HERE / name).is_file()]
    if missing:
        raise RuntimeError('Incomplete bundle: ' + ', '.join(missing))
    output.mkdir(parents=True, exist_ok=False)
    def git(*args):
        return subprocess.check_output(['git', '-C', str(HERE), *args], text=True).strip()
    for name in FILES:
        shutil.copy2(HERE / name, output / name)
    manifest = {'scope': 'TOOL_BUNDLE_NOT_HARDWARE_PASS', 'created_utc': utc(),
                'canonical_git_revision': git('rev-parse', 'HEAD'),
                'canonical_branch': git('branch', '--show-current'),
                'canonical_worktree_status': git('status', '--short'),
                'source_sha256': {name: sha256(output / name) for name in FILES}}
    write_json(output / 'bundle-manifest.json', manifest)
    (output / 'SHA256SUMS').write_text(''.join(f'{digest}  {name}\n' for name, digest in
        {**manifest['source_sha256'], 'bundle-manifest.json': sha256(output / 'bundle-manifest.json')}.items()))
    return manifest


def verify(directory):
    manifest = json.loads((directory / 'bundle-manifest.json').read_text())
    for name, expected in manifest['source_sha256'].items():
        if Path(name).name != name or sha256(directory / name) != expected:
            raise RuntimeError('Runtime source changed: ' + name)
    return manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('build', 'verify'))
    parser.add_argument('directory', type=Path)
    args = parser.parse_args()
    manifest = build(args.directory) if args.command == 'build' else verify(args.directory)
    print(json.dumps({'tooling': 'PASS', 'files': len(manifest['source_sha256']),
                      'canonical_revision': manifest['canonical_git_revision']}))


if __name__ == '__main__':
    main()
# Camera-free preparation and future N1 → N2 → N3 execution

**STOP before hardware execution until the user explicitly sends `CAMERA AVAILABLE`.**
This runbook supersedes execution suggestions in historical COMMANDS.md and
reports. Offline/synthetic success means **TOOLING PASS**, never hardware PASS.
No ORB-SLAM3, live VIO, firmware/calibration changes or motor-control work here.

## Ownership and evidence

Mac checkout is canonical; Pi runs an isolated checksummed copy. Preserve both
Git checkouts and historical results. Acquisition, CSV/image processing,
recording and replay execute on the Pi. SSH carries control and small evidence.
Native SDK owns sensor threads; Python main threads own child processes and
one-Hz health sampling. ROS wrapper owns its capture threads; recorder and
observer are separate owned subprocesses. STM32H7 owns hard-real-time safety.

Keep `manifest.json`, historical SDK logs/results, `run_sdk_capture.py`,
`analyze_sdk_csv.py`, and `sample_ir.cpp` unchanged as provenance. Future commands
use the new guarded utilities. All output paths must be new. Archive failed
runs; never repair a bag with reindex and call its original shutdown clean.

The archived ~105-second native run is useful history but is **not final N2**.
Its original sample CSVs and three PGM files are not in this Mac repository.
See [EVIDENCE_RECONCILIATION.md](EVIDENCE_RECONCILIATION.md).

## Phase A: safe now

