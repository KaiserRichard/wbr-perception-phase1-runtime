+                            'temperature_c': 60, 'vcgencmd_temperature_c': 60,
+                            'memory_available_kib': 524288, 'storage_free_bytes': 1024**3}
+                sampler.sample.side_effect = sample
+                with patch.object(sdk_capture, 'require_n1', return_value=n1) as require, \
