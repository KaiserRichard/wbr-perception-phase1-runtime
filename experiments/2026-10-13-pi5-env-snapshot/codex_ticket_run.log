+                        patch.object(n1_precheck, 'provenance', return_value={'os_release': 'VERSION_ID="24.04"'}), \
+                        patch.object(n1_precheck, 'checked', side_effect=checked), patch.object(n1_precheck, 'read', side_effect=read), \
