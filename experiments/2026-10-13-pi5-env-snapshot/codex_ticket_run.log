 from pathlib import Path
 import socket
 import subprocess
+import re
+
+# Historical unit: SDK 243322073847; ASIC/update/USB 251843061466.
+ACTIVE_UNIT = {"device_serial": "317422076650", "asic_serial": "327743061057", "firmware_update_id": "327743061057", "usb_descriptor_serial": "327743061057"}
+EXPECTED_CAMERA = {**ACTIVE_UNIT, "firmware": "5.17.3.10", "imu_type": "BMI085"}
+# BMI085 is a required N1 observation, not a measured fact about the new unit.
+
+
+def baseline_text(path):
+    return Path(path).read_text().replace('${ACTIVE_DEVICE_SERIAL}', ACTIVE_UNIT['device_serial'])
+
+
+def power_mode(diagnostic=False):
+    return 'diagnostic_latched_history' if diagnostic else 'strict'
+
+
+def throttled_value(raw):
+    match = re.fullmatch(r'throttled=(0x[0-9a-fA-F]+)', raw)
+    if not match:
+        raise ValueError('Cannot interpret throttling flags: ' + raw)
+    return int(match[1], 16)
+
+
+def power_allowed(value, diagnostic=False):
+    return value >= 0 and (value & ~0xF0000 == 0 if diagnostic else value == 0)
+
+
+def power_verdict(verdict, diagnostic=False):
+    return 'OPEN_DIAGNOSTIC' if diagnostic and verdict in ('PASS', 'REVIEW_REQUIRED') else verdict
 
 
