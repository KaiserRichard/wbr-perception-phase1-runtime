+                 ('throttled=0x0', True, False, 'OPEN_DIAGNOSTIC'),
+                 ('throttled=0x50005', True, False, 'FAIL'),
+                 ('throttled=0x0', False, True, 'FAIL')]
+        for raw, diagnostic, old, verdict in cases:
+            identity = dict(n1_precheck.EXPECTED)
