+def power_mode(diagnostic=False):
+    return 'diagnostic_latched_history' if diagnostic else 'strict'
+
+
+def throttled_value(raw):
+    match = re.fullmatch(r'throttled=(0x[0-9a-fA-F]+)', raw)
+    if not match:
+        raise ValueError('Cannot interpret throttling flags: ' + raw)
+    return int(match[1], 16)
+
+
+def power_allowed(value, diagnostic=False):
+    return value >= 0 and (value & ~0xF0000 == 0 if diagnostic else value == 0)
+
+
+def power_verdict(verdict, diagnostic=False):
+    return 'OPEN_DIAGNOSTIC' if diagnostic and verdict in ('PASS', 'REVIEW_REQUIRED') else verdict
 
 
 def utc():
