[
  "docker",
  "run",
  "-d",
  "--name",
  "d435i-resume-c",
  "--network",
  "host",
  "--ipc",
  "host",
  "--privileged",
  "-v",
  "/dev:/dev",
  "--user",
  "richard",
  "--group-add",
  "44",
  "-e",
  "ROS_DOMAIN_ID=42",
  "-e",
  "FASTDDS_BUILTIN_TRANSPORTS=UDPv4",
  "-e",
  "RMW_IMPLEMENTATION=rmw_fastrtps_cpp",
  "sha256:f05425cd25e92f1e1a54d0e5a255d87d781251f0f9dc6579296a98458c7364e8",
  "ros2",
  "run",
  "realsense2_camera",
  "realsense2_camera_node",
  "--ros-args",
  "-r",
  "__node:=camera",
  "-r",
  "__ns:=/",
  "-r",
  "/camera/infra1/image_rect_raw:=/camera/image_raw",
  "-r",
  "/camera/infra1/camera_info:=/camera/camera_info",
  "-p",
  "enable_color:=false",
  "-p",
  "enable_depth:=false",
  "-p",
  "enable_infra1:=true",
  "-p",
  "enable_infra2:=false",
  "-p",
