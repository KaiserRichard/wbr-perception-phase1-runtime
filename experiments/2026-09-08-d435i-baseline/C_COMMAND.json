  "-p",
  "enable_gyro:=true",
  "-p",
  "enable_accel:=true",
  "-p",
  "gyro_fps:=200",
  "-p",
  "accel_fps:=100",
  "-p",
  "unite_imu_method:=2",
  "-p",
  "json_file_path:=/config/advanced.json"
