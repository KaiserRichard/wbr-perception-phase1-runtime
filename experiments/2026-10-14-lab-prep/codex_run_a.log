+```bash
+WBR_OFFLINE="$WBR_SESSION/offline"
+mkdir "$WBR_OFFLINE" && cd "$WBR_OFFLINE"
+sha256sum "$WBR_BAG" "$WBR_YAML" > inputs.sha256
+if /usr/bin/time -v "$WBR_BIN/stereo_inertial_realsense_D435i" \
