#!/bin/bash
# Diagnostic (OPEN) D435i recording into RAM (/dev/shm), copied to the card afterwards. Usage: smoke_ram.sh NAME SECONDS
B=$HOME/wbr-runtime/n4b-20261013T080913Z
R=$HOME/wbr-evidence/2026-10-14-d435i-$1; mkdir -p $R
S=/dev/shm/wbr-take-$1
(while true; do echo "$(date -u +%FT%TZ) $(vcgencmd get_throttled) $(vcgencmd pmic_read_adc EXT5V_V | awk '{print $2}') $(vcgencmd measure_temp) $(vcgencmd measure_clock arm)"; sleep 1; done) > $R/power-1hz.log & P=$!
journalctl -k -f -n0 -o short-iso-precise > $R/kernel.log 2>&1 & K=$!
sleep 1
$B/bin/d435i_record $S $2 > $R/record.log 2>&1; echo "rc=$?" >> $R/record.log
kill $P $K
python3 $B/bin/analyze_take.py $S/timestamps.csv > $R/analysis.json 2>&1
T0=$(date +%s); cp -a $S $R/take && sync; echo "copy_to_card_s=$(( $(date +%s)-T0 ))" >> $R/record.log
(cd $S && sha256sum *) > $R/ram-sha256.txt; (cd $R/take && sha256sum -c ../ram-sha256.txt) >> $R/record.log 2>&1 && rm -rf $S
du -B1 $R/take/* > $R/sizes.txt
echo DONE
#!/usr/bin/env python3
"""Summarize a d435i_record timestamps.csv: per-stream counts, rates, gaps, ordering. Diagnostic only (OPEN)."""
import csv
import json
import sys
from collections import defaultdict

LIMITS = {"Infrared 1": 30, "Infrared 2": 30, "Gyro": 200, "Accel": 100}


def main(path):
    rows = defaultdict(list)
    domains = defaultdict(set)
    with open(path) as f:
        for r in csv.DictReader(f):
            key = r["stream"] if r["stream"] not in ("Infrared",) else f"Infrared {r['index']}"
            rows[key].append((float(r["sdk_ms"]), int(r["frame_number"]), int(r["host_steady_ns"])))
            domains[key].add(r["domain"])
    out = {}
    for k, v in sorted(rows.items()):
        t = [x[0] for x in v]
        n = [x[1] for x in v]
        dt = [b - a for a, b in zip(t, t[1:])]
        span = (t[-1] - t[0]) / 1000 if len(t) > 1 else 0
        nominal = LIMITS.get(k)
        out[k] = {
            "count": len(v),
            "span_s": round(span, 3),
            "rate_hz": round((len(v) - 1) / span, 3) if span else None,
            "nominal_hz": nominal,
            "max_gap_ms": round(max(dt), 3) if dt else None,
            "nonpositive_steps": sum(1 for d in dt if d <= 0),
            "frame_number_skips": sum(1 for a, b in zip(n, n[1:]) if b - a > 1) if k.startswith("Infrared") else None,
            "domains": sorted(domains[k]),
            "host_minus_sdk_spread_ms": round(
                (max(x[2] / 1e6 - x[0] for x in v) - min(x[2] / 1e6 - x[0] for x in v)), 3),
        }
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main(sys.argv[1])

