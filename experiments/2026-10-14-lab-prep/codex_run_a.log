+mkdir "$WBR_SESSION"
+(cd "$WBR_HELPERS" && sha256sum -c SHA256SUMS)
+cd "$WBR_ORB"
+rg -n 'mpCurrentKeyFrame.*nullptr' include/LocalMapping.h
+cmake --build build -j4 2>&1 | tee "$WBR_SESSION/rebuild.log"
