+    for index, stamp in enumerate(short[:, 0]):
+        insertion = int(np.searchsorted(long[:, 0], stamp))
+        choices = [i for i in (insertion - 1, insertion) if 0 <= i < len(long)]
+        nearest = min(choices, key=lambda i: (abs(long[i, 0] - stamp), i))
