diff --git a/User/APP/terrain_advisory.c b/User/APP/terrain_advisory.c
new file mode 100644
index 0000000..0ff9622
--- /dev/null
+++ b/User/APP/terrain_advisory.c
@@ -0,0 +1,81 @@
+#include "terrain_advisory.h"
+
+#include "FreeRTOS.h"
+#include "task.h"
+#include <limits.h>
+#include <math.h>
+
+static TerrainAdvisorySnapshot_t s_advisory = {
+    .code = TERRAIN_ADVISORY_UNCERTAIN,
+    .stale = 1U
+};
+static uint32_t s_last_update_ms;
+static uint8_t s_has_update;
+
+bool terrain_advisory_validate(const double *data, size_t len)
+{
+    if (data == NULL || len != TERRAIN_ADVISORY_DATA_LEN) return false;
+
+    for (size_t i = 0U; i < TERRAIN_ADVISORY_DATA_LEN; i++)
+    {
+        if (!isfinite(data[i])) return false;
+    }
+
+    if (data[0] < 0.0 || data[0] > 3.0 || floor(data[0]) != data[0]) return false;
+    if (data[1] < 0.0 || data[2] < 0.0 || data[3] < 0.0) return false;
+    if (data[4] < 0.0 || data[4] > 1.0) return false;
+    if (data[5] != 0.0 && data[5] != 1.0) return false;
+
+    return true;
+}
+
+bool terrain_advisory_store(const double *data, size_t len, uint32_t now_ms)
+{
+    if (!terrain_advisory_validate(data, len))
+    {
+        taskENTER_CRITICAL();
+        s_advisory.rejected++;
+        taskEXIT_CRITICAL();
+        return false;
+    }
+
+    taskENTER_CRITICAL();
+    s_advisory.code = (TerrainAdvisoryCode_t)data[0];
+    s_advisory.distance_m = data[1];
+    s_advisory.height_m = data[2];
+    s_advisory.width_m = data[3];
+    s_advisory.confidence = data[4];
+    s_advisory.plane_valid = (uint8_t)data[5];
+    /* Sequence is carried as a finite float64 in the specified array. Keep
+     * the UInt32 ack conversion defined even for an out-of-range input. */
+    if (data[6] <= 0.0) s_advisory.last_seq = 0U;
+    else if (data[6] >= (double)UINT32_MAX) s_advisory.last_seq = UINT32_MAX;
+    else s_advisory.last_seq = (uint32_t)data[6];
+    s_advisory.accepted++;
+    s_last_update_ms = now_ms;
+    s_has_update = 1U;
+    taskEXIT_CRITICAL();
+    return true;
+}
+
+TerrainAdvisorySnapshot_t terrain_advisory_get_snapshot(uint32_t now_ms)
+{
+    TerrainAdvisorySnapshot_t snapshot;
+
+    taskENTER_CRITICAL();
+    snapshot = s_advisory;
+    if (!s_has_update)
+    {
+        snapshot.age_ms = UINT32_MAX;
+        snapshot.stale = 1U;
+    }
+    else
+    {
+        snapshot.age_ms = now_ms - s_last_update_ms;
+        snapshot.stale = (snapshot.age_ms >= TERRAIN_ADVISORY_STALE_MS) ? 1U : 0U;
+        if (snapshot.stale) snapshot.code = TERRAIN_ADVISORY_UNCERTAIN;
+    }
+    taskEXIT_CRITICAL();
+
+    return snapshot;
+}
