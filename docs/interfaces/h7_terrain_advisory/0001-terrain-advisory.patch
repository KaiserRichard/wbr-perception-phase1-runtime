+/* Receive-only advisory input. It is validated and copied into its isolated
+ * snapshot; it has no path to motor commands, modes, watchdogs or RC state. */
+static void terrain_advisory_callback(const void *msg_in)
+{
+  const std_msgs__msg__Float64MultiArray *msg =
+    (const std_msgs__msg__Float64MultiArray *)msg_in;
+  if (msg == NULL)
+  {
+    (void)terrain_advisory_store(NULL, 0U, HAL_GetTick());
+    return;
+  }
+
+  (void)terrain_advisory_store(msg->data.data, msg->data.size, HAL_GetTick());
+}
