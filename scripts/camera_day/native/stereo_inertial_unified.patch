+            while (!pending_gyro.empty() && accel_samples.size() >= 2) {
+                const auto g = pending_gyro.front();
+                if (g.first < accel_samples.front().first) {
+                    pending_gyro.pop_front(); // startup has no accel bracket
+                    continue;
+                }
+                while (accel_samples.size() > 2 && accel_samples[1].first < g.first)
+                    accel_samples.pop_front();
+                const auto a = accel_samples[0], b = accel_samples[1];
+                if (g.first > b.first) break;
+                if (b.first <= a.first) {
+                    imu_callback_error.store(true);
+                    cond_image_rec.notify_all();
+                    return; // Report this fault from the main thread.
+                }
+                const double alpha = (g.first - a.first) / (b.first - a.first);
+                rs2_vector value;
+                value.x = a.second.x + alpha * (b.second.x - a.second.x);
+                value.y = a.second.y + alpha * (b.second.y - a.second.y);
+                value.z = a.second.z + alpha * (b.second.z - a.second.z);
